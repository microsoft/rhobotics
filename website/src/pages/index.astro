  { label: "YAM Box (in the wild)", pct: 17.53, color: pieColors.yamWild, detail: "1,004 h @ 30 Hz" },
  { label: "YAM Box", pct: 9.53, color: pieColors.yamBox, detail: "449 h @ 30 Hz" },
