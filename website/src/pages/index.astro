  { label: "FR3 Duo", pct: 11.03, color: pieColors.fr3, detail: "278 h @ 30 Hz" },
  { label: "Trossen Stationary AI", pct: 2.87, color: pieColors.trossen, detail: "72 h @ 30 Hz" },
  { label: "OXE Amuse Bouche", pct: 2.73, color: pieColors.oxe, detail: "292 h @ 3–30 Hz" },
  { label: "OmniReset UR AI Trainer (sim)", pct: 0.69, color: pieColors.sim, detail: "36 h @ 50 Hz" },
  { label: "Vision-language data", pct: 10.0, color: pieColors.vqa, detail: "RoboPoint + RefSpatial VQA, 5% each" },
];

const vqaSlices = [
  { label: "Vision-language data", pct: 10.0, color: pieColors.vqa },
];

const midtrainingMixes = [
  {
    checkpoint: "Rho-YAM-Box",
