  .release-grid a:hover {
    border-color: var(--link);
    text-decoration: none;
  }
  .release-grid strong { color: var(--link); }
  .release-grid span { color: var(--text-muted); font-size: var(--type-body); }
  @media (max-width: 820px) {
    .adaptation-flow {
      grid-template-columns: repeat(2, 1fr);
    }
    .adaptation-stage__arrow {
      display: none;
    }
    .feature-grid,
    .embodiment-grid,
    .online-results-grid { grid-template-columns: repeat(2, 1fr); }
    .hardware-result { grid-template-columns: 1fr; gap: 20px; }
    .hardware-result--reverse { grid-template-columns: 1fr; }
    .hardware-result--reverse > div,
    .hardware-result--reverse > figure { order: initial; }
  }
  @media (max-width: 560px) {
    .section { padding-block: 56px; }
    .hero__stats,
    .adaptation-flow,
    .adaptation-details,
    .feature-grid,
    .embodiment-grid,
    .clip-grid,
    .hero__media,
    .task-clips--fr3,
    .task-clips--ur5e,
    .online-results-grid,
    .release-grid { grid-template-columns: 1fr; }
    .hero__stats div { border-right: 0; border-bottom: 1px solid var(--rule); }
    .hero__stats div:last-child { border-bottom: 0; }
  }
  /* Two spec tables (or two ablation tables) side by side. */
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-top: 28px;
  }
  .spec-grid h3 {
    margin: 0;
    font-size: var(--type-subsection-heading);
  }
  .spec-grid .table-wrap { margin: 12px 0 0; }
  .spec-grid .table-subhead { margin: 0; }
  .result-block .spec-grid { margin-top: 20px; }
  /* Midtraining mixture cards reuse the diagnostic-card look. */
  .mixture-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 44px;
  }
  .diagnostic-card__lbl--light {
    color: var(--text-muted);
    font-weight: 500;
  }
  .online-results-grid .note--dark { margin: 0 0 14px; }
  .release-grid + .feature-grid { margin-top: 54px; }
  .systems-details { margin-top: 36px; }
  .spec-grid > * { min-width: 0; }
  @media (max-width: 900px) {
    .spec-grid { grid-template-columns: minmax(0, 1fr); }
  }
  /* Shape sweep + Compression: the second table is the wider one, so give it
     exactly the width its columns need and leave the rest to the first, whose
     subhead then fits on one line. Stack the two once the wide column can no
     longer hold both without a horizontal scrollbar. */
  .spec-grid--results {
    grid-template-columns: minmax(0, 1fr) minmax(0, max-content);
    grid-template-rows: auto auto;
    row-gap: 0; /* the tables' own 12px top margin separates them from the subheads */
  }
  /* Each column is a subgrid of the two rows above, so both subheads share
     row 1 and both tables share row 2: the tables start level even when only
     one subhead wraps onto a second line. */
  .spec-grid--results > * {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
  }
  /* ...but don't stretch the shorter table's frame down to the taller one. */
  .spec-grid--results .table-wrap { align-self: start; }
  .spec-grid--results th,
  .spec-grid--results td { padding-inline: 10px; }
  @media (max-width: 1200px) {
    .spec-grid--results {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 22px;
    }
    .spec-grid--results > * {
      display: block;
      grid-row: auto;
    }
  }
  @media (max-width: 720px) {
    .mixture-grid { grid-template-columns: 1fr; }
  }
  /* Five recipe stages in one row; below 1100px the fifth spans a full row. */
  .adaptation-flow {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }
  .adaptation-stage {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 20px 18px;
  }
  .adaptation-stage__description { min-height: 0; }
  /* Pin the data/mixture/output summary to the card bottom, whatever the text length. */
  .adaptation-stage dl {
    margin-top: auto;
    padding-top: 22px;
  }
  .adaptation-stage__arrow { right: -27px; }
  /* Two per row when five don't fit; an odd last card sits centred on its own
     row rather than stretching across it. */
  @media (max-width: 1100px) {
    .adaptation-flow {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }
    .adaptation-stage { flex: 0 1 calc((100% - 16px) / 2); }
    .adaptation-stage__arrow { display: none; }
  }
  @media (max-width: 560px) {
