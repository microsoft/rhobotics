---
import BaseLayout from "../layouts/BaseLayout.astro";
import MixturePie from "../components/MixturePie.astro";
import BarChart from "../components/BarChart.astro";
import ChartLegend from "../components/ChartLegend.astro";
import { withBase } from "../lib/url";

const resources = [
  { label: "Technical report", href: "https://arxiv.org/abs/2609.38164" },
  { label: "Code", href: "https://github.com/microsoft/rhobotics" },
  { label: "Models", href: "https://huggingface.co/collections/microsoft/rho" },
  { label: "Data", href: "https://huggingface.co/collections/microsoft/rho" },
];

// Author list as in the tech report (alphabetical); one inner array per printed line.
const leadRoles: Record<string, string> = {
  "♠": "Project lead",
  "∗": "Data lead",
  "§": "Training lead",
  "‡": "Engineering lead",
  "†": "VLM lead",
};

const authorLines: { name: string; marks?: string }[][] = [
  [
    { name: "Simran Bagaria" },
    { name: "Daphne Chen" },
    { name: "Dean Fortier" },
    { name: "Jianlong Fu" },
  ],
  [
    { name: "Michael Harrison" },
    { name: "Tess Hellebrekers" },
    { name: "Neel Joshi", marks: "†" },
    { name: "Andrey Kolobov", marks: "♠∗" },
    { name: "Dalton Moore" },
  ],
  [
    { name: "Galen Mullins", marks: "‡" },
    { name: "Michael Murray", marks: "§" },
    { name: "Eduardo Salinas" },
    { name: "Reuben Tan" },
  ],
];

const describeMarks = (marks: string) =>
  [...marks].map((mark) => leadRoles[mark]).join(", ");

const modelCitations: Record<string, string> = {
  "OpenVLA": "https://openvla.github.io/",
  "π0": "https://arxiv.org/abs/2410.24164",
  "π0.5": "https://arxiv.org/abs/2504.16054",
  "OpenPI π0.5": "https://arxiv.org/abs/2504.16054",
  "MolmoAct-7B-D": "https://github.com/allenai/molmoact",
  "MolmoAct2": "https://arxiv.org/abs/2605.02881",
  "GR00T": "https://huggingface.co/nvidia/GR00T-N1.7-3B",
  "GR00T N1.7": "https://huggingface.co/nvidia/GR00T-N1.7-3B",
};

const checkpoints = {
  base: "https://huggingface.co/microsoft/rho-base",
  yam: "https://huggingface.co/microsoft/rho-yam-box",
  ur: "https://huggingface.co/microsoft/rho-ur-ai-trainer",
  fr3: "https://huggingface.co/microsoft/rho-fr3-duo",
  libero: "https://huggingface.co/microsoft/rho-libero",
  roboeval: "https://huggingface.co/microsoft/rho-roboeval",
  busybox: "https://huggingface.co/datasets/microsoft/BusyBox",
};

// --- Training recipe (report Sections 2-5) ---------------------------------

const adaptationStages = [
  {
    number: "01",
    label: "Ground",
    title: "Phi-Phy",
    subtitle: "Physically grounded VLM",
    description:
      "A 4.68B-parameter Phi-family vision-language model gets extra robotics-relevant grounding, pointing, spatial-reasoning, and multi-image VQA training, so it understands physical scenes before it is asked to control anything.",
    data: "≈36M physical-grounding records in a 100M-record SFT mix",
    mix: "General VLM data + physical grounding",
    output: "Phi-Phy backbone (no actions yet)",
  },
  {
    number: "02",
    label: "Pretrain",
    title: "Rho-base",
    subtitle: "Multi-embodiment VLA",
    description:
      "A 542M-parameter flow-matching action expert is attached and trained with the backbone on Rho-Tomyum: 3,200+ hours from more than a dozen robots, mostly dual-arm, plus VQA data that keeps the backbone grounded.",
    data: "3,200+ robot hours · 48 B200 GPUs",
    mix: "90% robot data · 10% vision-language",
    output: "Rho-base: the shared foundation",
  },
  {
    number: "03",
    label: "Midtrain",
    title: "Rho-⟨robot⟩",
    subtitle: "Embodiment-specific VLA",
    description:
      "Rho-base is trained for two epochs on ~300 hours of one robot's data across dozens of task families. The goal is to learn the robot — cameras, kinematics, workspace, control conventions — not to master any one task.",
    data: "≈280–300 hours of one robot · 19–65 task families",
    mix: "90% target robot · 10% vision-language",
    output: "Rho-YAM-Box · Rho-UR-AI-Trainer · Rho-FR3-Duo",
  },
  {
    number: "04",
    label: "Finetune",
    title: "Task policy",
    subtitle: "Offline task adaptation",
    description:
      "A midtrained variant is finetuned on demonstrations of the target task: same flow-matching objective, all parameters trainable, robot data only. Because the robot is already familiar, a few hundred demonstrations go a long way.",
    data: "≈100–300 demonstrations per task on physical robots",
    mix: "100% target-task demonstrations",
    output: "Deployable task policy",
  },
  {
    number: "05",
    label: "Correct",
    title: "Online adaptation",
    subtitle: "Learning from corrections",
    description:
      "After deployment, a small latent policy inside the model learns from human corrective takeovers while the backbone and action expert stay frozen. It changes only where action generation starts, so the offline-learned behavior is preserved.",
    data: "15 corrected episodes per task on FR3 Duo",
    mix: "Corrective takeovers only; rest of the model frozen",
    output: "The stage-04 task policy, improved in place",
  },
];

// Mixture pies (report Figures 3 and 4). Shares are of training updates; the
// colour families follow the report's figures (cool hues: YAM/UMI sources,
// reds and oranges: UR/FR3/Trossen). Steps are adjusted from the report's so
// that neighbouring slices stay distinguishable in all four charts, including
// under colour-vision deficiency (validated with the dataviz palette checker).
// A colour always means the same source. RoboPoint and RefSpatial are always an
// even 5% / 5% split, so they are drawn as one vision-language slice.
const pieColors = {
  xmi: "#17598F",
  yamWild: "#4A90D9",
  yamBox: "#12A07A",
  yamStation: "#6CB8F0",
  ur: "#8A2E08",
  fr3: "#D1491B",
  trossen: "#E8963F",
  oxe: "#6E6AC8",
  sim: "#A03A82",
  vqa: "#D4B02A",
};

