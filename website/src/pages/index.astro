    width: 100%;
    max-width: none;
  }
  details {
    margin-top: 22px;
    padding: 16px 18px;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  summary { cursor: pointer; font-weight: 650; }
  .badge {
    display: inline-block;
    margin-bottom: 8px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(120, 199, 255, 0.16);
    color: #78c7ff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  .diagnostic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 24px;
  }
  .diagnostic-card {
    display: flex;
