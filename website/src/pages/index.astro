---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";

const resources = [
  { label: "Code", href: "https://github.com/microsoft/rhobotics" },
  { label: "Base checkpoint", href: "https://huggingface.co/microsoft/rho-base" },
  { label: "LIBERO checkpoint", href: "https://huggingface.co/microsoft/rho-libero" },
  { label: "BusyBox dataset", href: "https://huggingface.co/datasets/microsoft/BusyBox" },
];

const modelSpecs = [
  ["Action expert", "542M parameters"],
  ["Transformer", "12 blocks; width 2,048; MLP width 4,096"],
  ["Attention", "Action self-attention and cross-attention to VLM context"],
  ["Block structure", "16 query heads; 4 key/value heads; head dimension 128"],
  ["Flow conditioning", "Shared adaLN-single with block-specific offsets"],
  ["Flow target", "Linear noise-action interpolation; velocity-prediction MSE"],
  ["State/action interface", "Continuous vectors up to 32 dimensions with padding and loss masks"],
  ["Inference solver", "10 explicit Euler steps"],
];

const liberoRows = [
  ["OpenVLA", "84.7", "88.4", "79.2", "53.7", "76.5"],
  ["π0", "96.8", "98.8", "95.8", "85.2", "94.2"],
  ["MolmoAct-7B-D", "87.0", "95.4", "87.6", "77.2", "86.6"],
  ["GR00T N1.7", "95.0", "100.0", "98.0", "93.0", "96.5"],
  ["π0.5", "98.8", "98.2", "98.0", "92.4", "96.9"],
  ["MolmoAct2", "97.8", "100.0", "97.8", "93.2", "97.2"],
  ["Rho", "98.3", "99.6", "97.6", "95.9", "97.9"],
];

const midtrainingRows = [
  ["RoboTwin midtraining_set_B", "23,100", "3,238,752", "50", "18.0", "18.0"],
  ["UR_AI_Trainer", "141,007", "47,357,161", "50", "263.1", "263.1"],
  ["FR3_Duo", "23,793", "29,986,315", "30", "277.7", "277.7"],
  ["YAM_Box_lab", "36,177", "48,527,355", "30", "449.3", "147.6"],
  ["YAM_Box_wild", "76,486", "108,383,230", "30", "1,003.5", "152.4"],
];

const efficiencyRows = [
  ["OpenPI π0.5", "Full fine-tuning", "3.0B", "On", "71.7 GB", "1.70 s"],
  ["GR00T", "Full fine-tuning", "3.14B (100%)", "Off", "85.2 GB", "0.81 s"],
  ["Rho", "Full, NFS=1", "4.92B (94%)", "On", "30.4 GB", "1.16 s"],
  ["Rho", "Full, NFS=8", "4.92B (94%)", "On", "35.0 GB", "1.63 s"],
  ["MolmoAct2", "Full, NFS=1", "5.05B (93%)", "On", "59.2 GB", "3.70 s"],
  ["MolmoAct2", "Full, NFS=8", "5.05B (93%)", "On", "59.5 GB", "3.80 s"],
  ["MolmoAct2", "Expert-only, NFS=1", "578M (10.6%)", "—", "19.3 GB", "2.20 s"],
  ["MolmoAct2", "Expert-only, NFS=8", "578M (10.6%)", "—", "19.8 GB", "2.30 s"],
  ["GR00T", "Expert-only", "1.62B (51%)", "Off", "41.6 GB", "0.42 s"],
  ["Rho", "Expert-only, NFS=1", "544M (10%)", "On", "17.2 GB", "0.38 s"],
  ["Rho", "Expert-only, NFS=8", "544M (10%)", "On", "20.2 GB", "0.88 s"],
];

const robotwinSummary = [
  ["OLA-Sem", "50-task co-training", "69.0", "60.8", "64.9"],
  ["GigaBrain-0.7", "50-task co-training", "60.8", "65.2", "63.0"],
  ["Rho 100% Midtrain", "Five-task fine-tuning", "65.6", "59.6", "62.6"],
  ["Rho 100% Pretrain", "Five-task fine-tuning", "65.2", "56.9", "61.1"],
  ["Rho All-UR5", "50-task fine-tuning", "59.3", "55.7", "57.5"],
  ["4D-WAM", "50-task co-training", "73.2", "26.8", "50.0"],
  ["π0.5", "50-task co-training", "59.6", "35.2", "47.4"],
  ["π0", "Per-task fine-tuning", "51.0", "9.2", "30.1"],
];

const embodiments = [
  {
    name: "FR3 Duo",
    image: "assets/fr3_duo.jpg",
    checkpoint: "https://huggingface.co/microsoft/rho-fr3-duo",
  },
  {
    name: "UR5e AI Trainer",
    image: "assets/ur_ai_trainer.jpg",
    checkpoint: "https://huggingface.co/microsoft/rho-ur-ai-trainer",
  },
  {
    name: "YAMBox",
    image: "assets/yam_box.jpg",
    checkpoint: "https://huggingface.co/microsoft/rho-yam-box",
  },
];
---

<BaseLayout
  title="Rho — Open Vision-Language-Action Models for Robotics"
  description="Rho is a family of open-weight vision-language-action models for bimanual robotic manipulation and efficient embodiment adaptation."
>
  <section class="hero">
    <div class="container container--wide">
      <p class="eyebrow">Open-weight vision-language-action models</p>
      <h1>Rho</h1>
      <p class="hero__dek">
        A family of general-purpose physical AI models for bimanual manipulation,
        combining a physically grounded Phi-family backbone with a flow-matching
        action expert and a progressive embodiment-adaptation recipe.
      </p>
      <div class="hero__links">
        {resources.map((resource) => (
          <a class="button" href={resource.href} target="_blank" rel="noopener noreferrer">
            {resource.label}<span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <dl class="hero__stats">
        <div><dt>LIBERO average</dt><dd>97.9%</dd></div>
        <div><dt>RoboEval average</dt><dd>73.4%</dd></div>
        <div><dt>RoboTwin average</dt><dd>62.6%</dd></div>
      </dl>
      <div class="hero__media" aria-label="Rho manipulation examples">
        <figure>
          <img
            src={withBase("assets/fr3-charger-move.webp")}
            alt="Rho controlling the FR3 Duo to move a charger"
          />
          <figcaption>Language-conditioned charger manipulation.</figcaption>
        </figure>
        <figure>
          <img
            src={withBase("assets/yambox-repositioning.webp")}
            alt="Rho rotating and repositioning a panel"
          />
          <figcaption>Bimanual panel rotation and repositioning.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <nav class="section-nav" aria-label="Page sections">
    <div class="container container--wide">
      <a href="#overview">Overview</a>
      <a href="#method">Method</a>
      <a href="#embodiments">Embodiments</a>
      <a href="#benchmarks">Benchmarks</a>
      <a href="#efficiency">Efficiency</a>
      <a href="#models">Models</a>
    </div>
  </nav>

  <div class="page-content">
    <section id="overview" class="section container">
      <p class="section-kicker">Overview</p>
      <h2>Broad perception, precise control, efficient adaptation</h2>
      <div class="lede-grid">
        <p class="lede">
          General-purpose physical AI models must combine visual and linguistic
          understanding with precise control across robot embodiments. Rho couples a
          physically grounded vision-language backbone to a continuous action expert,
          then adapts to new hardware through targeted mid-training.
        </p>
        <p>
          Rho uses a fraction of the pretraining data of similarly sized VLAs while
          achieving strong results in LIBERO, RoboEval, RoboTwin, and physical
          manipulation experiments. The base checkpoint is available as
          <a href="https://huggingface.co/microsoft/rho-base">microsoft/rho-base</a>.
        </p>
      </div>
      <div class="feature-grid">
        <article>
          <span class="feature-number">01</span>
          <h3>Physically grounded VLM</h3>
          <p>Additional robotics-relevant grounding, multi-image reasoning, OCR, counting, and synthetic visual reasoning data.</p>
        </article>
        <article>
          <span class="feature-number">02</span>
          <h3>Flow-matching action expert</h3>
          <p>A compact continuous-action decoder with cross-attention to VLM context and configurable action chunks.</p>
        </article>
        <article>
          <span class="feature-number">03</span>
          <h3>Flexible LeRobot training</h3>
          <p>YAML-configured datasets, transforms, key mappings, action representations, and multi-dataset training.</p>
        </article>
      </div>
    </section>

    <section id="method" class="section section--tint">
      <div class="container container--wide">
        <p class="section-kicker">Architecture</p>
        <h2>Rho flow-matching action expert</h2>
        <p class="section-intro">
          Visual observations, language instructions, and robot state condition a
          continuous action expert that generates chunks of future actions.
        </p>
        <figure class="figure figure--paper">
          <a href={withBase("assets/action_expert.pdf")} target="_blank">
            <img src={withBase("assets/action-expert.png")} alt="Rho flow-matching action expert architecture" />
          </a>
          <figcaption>
            State and noisy-action tokens pass through 12 transformer blocks with
            grouped-query self-attention, cross-attention to VLM context, and
            flow-timestep conditioning. Select the figure to open the PDF.
          </figcaption>
        </figure>
        <div class="table-wrap">
          <table>
            <tbody>
              {modelSpecs.map(([component, specification]) => (
                <tr><th scope="row">{component}</th><td>{specification}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="embodiments" class="section section--dark">
      <div class="container container--wide">
        <p class="section-kicker">Physical systems</p>
        <h2>Embodiment-targeted mid-training</h2>
        <p class="section-intro">
          Rho is mid-trained on a balanced mixture of robot data and
          robotics-relevant visual reasoning data before downstream fine-tuning.
          Each checkpoint was trained for two epochs—approximately 45,000 steps—with
          a global batch size of 1,024 on eight B200 GPUs.
        </p>
        <div class="embodiment-grid">
          {embodiments.map((embodiment) => (
            <article class="embodiment-card">
              <img src={withBase(embodiment.image)} alt={embodiment.name} loading="lazy" />
              <div>
                <h3>{embodiment.name}</h3>
                <a href={embodiment.checkpoint}>Checkpoint ↗</a>
              </div>
            </article>
          ))}
        </div>
        <div class="table-wrap table-wrap--dark">
          <table>
            <thead>
              <tr><th>Dataset</th><th>Episodes</th><th>Frames</th><th>FPS</th><th>Original hours</th><th>Sampled hours</th></tr>
            </thead>
            <tbody>
              {midtrainingRows.map((row) => (
                <tr>{row.map((value, index) => index === 0 ? <th scope="row">{value}</th> : <td>{value}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note note--dark">
          YAMBox was subsampled to roughly 300 hours, distributed evenly across task
          types, to align its mid-training volume with the other physical datasets.
        </p>
      </div>
    </section>

    <section class="section container container--wide">
      <div class="hardware-result">
        <div>
          <p class="section-kicker">FR3 Duo</p>
          <h2>Reliable multi-stage manipulation</h2>
          <p>
            Across plug insertion, tumbler manipulation, and test-tube racking,
            Rho achieves 80.0% success and 88.7% mean task progress.
          </p>
          <a class="text-link" href="https://huggingface.co/microsoft/rho-fr3-duo">
            Download rho-fr3-duo ↗
          </a>
        </div>
        <div class="task-clips task-clips--fr3" aria-label="FR3 Duo task examples">
          <figure>
            <img src={withBase("assets/fr3-beaker-open.webp")} alt="FR3 Duo opening a beaker" loading="lazy" />
            <figcaption>Opening a beaker</figcaption>
          </figure>
          <figure>
            <img src={withBase("assets/fr3-beaker-close.webp")} alt="FR3 Duo closing a beaker" loading="lazy" />
            <figcaption>Closing a beaker</figcaption>
          </figure>
          <figure>
            <img src={withBase("assets/fr3-glasses-stack-a.webp")} alt="FR3 Duo stacking glasses" loading="lazy" />
            <figcaption>Glass stacking</figcaption>
          </figure>
          <figure>
            <img src={withBase("assets/fr3-glasses-stack-b.webp")} alt="FR3 Duo unstacking glasses" loading="lazy" />
            <figcaption>Glass unstacking</figcaption>
          </figure>
        </div>
        <div class="hardware-result__plot">
          <figure class="figure">
            <img src={withBase("assets/fig-fr3-duo.png")} alt="FR3 Duo success rate and mean task progress" loading="lazy" />
            <figcaption>Success rate and mean task progress across the five FR3 Duo evaluation tasks.</figcaption>
          </figure>
        </div>
      </div>

      <div class="hardware-result hardware-result--reverse">
        <div>
          <p class="section-kicker">UR5e AI Trainer</p>
          <h2>Generalizing across cleanup tasks</h2>
          <p>
            Rho reaches 53.4% success and 70.0% mean task progress across toolbox
            and micro-electronics cleanup tasks.
          </p>
          <a class="text-link" href="https://huggingface.co/microsoft/rho-ur-ai-trainer">
            Download rho-ur-ai-trainer ↗
          </a>
        </div>
        <div class="task-clips task-clips--ur5e" aria-label="UR5e AI Trainer task examples">
          <figure>
            <img
              src={withBase("assets/ur5e-moving-two-items.webp")}
              alt="UR5e AI Trainer moving two items"
              loading="lazy"
            />
            <figcaption>Moving multiple items</figcaption>
          </figure>
          <figure>
            <img
              src={withBase("assets/ur5e-tool-chest.webp")}
              alt="UR5e AI Trainer performing a tool chest task"
              loading="lazy"
            />
            <figcaption>Tool chest cleanup</figcaption>
          </figure>
        </div>
        <div class="hardware-result__plot">
          <figure class="figure">
            <img
              src={withBase("assets/fig-ur-ai-trainer.png")}
              alt="UR5e AI Trainer success rate and mean task progress"
              loading="lazy"
            />
            <figcaption>Success rate and mean task progress across tasks with available UR5e evaluation data.</figcaption>
          </figure>
        </div>
      </div>

      <div class="hardware-result">
        <div>
          <p class="section-kicker">YAMBox</p>
          <h2>90% across BusyBox task families</h2>
          <p>
            Ten rollouts per task family evaluate buttons, switches, sliders,
            knobs, wires, and object repositioning on the
            <a href="https://github.com/microsoft/BusyBox">BusyBox benchmark</a>.
            The training dataset is available from
            <a href="https://huggingface.co/datasets/microsoft/BusyBox">Microsoft on Hugging Face</a>.
          </p>
          <a class="text-link" href="https://huggingface.co/microsoft/rho-yam-box">
            Download rho-yam-box ↗
          </a>
        </div>
        <figure class="figure">
          <img src={withBase("assets/fig-yam-box.png")} alt="YAMBox BusyBox benchmark results" loading="lazy" />
        </figure>
      </div>

      <div class="clip-grid" aria-label="YAMBox task examples">
        <figure>
          <img src={withBase("assets/yambox-buttons.webp")} alt="YAMBox operating a push button" loading="lazy" />
          <figcaption>Buttons</figcaption>
        </figure>
        <figure>
          <img src={withBase("assets/yambox-switches.webp")} alt="YAMBox operating a switch" loading="lazy" />
          <figcaption>Switches</figcaption>
        </figure>
        <figure>
          <img src={withBase("assets/yambox-slider.webp")} alt="YAMBox moving a slider" loading="lazy" />
          <figcaption>Sliders</figcaption>
        </figure>
        <figure>
          <img src={withBase("assets/yambox-knob.webp")} alt="YAMBox turning a knob" loading="lazy" />
          <figcaption>Knobs</figcaption>
        </figure>
        <figure>
          <img src={withBase("assets/yambox-wires.webp")} alt="YAMBox manipulating a wire" loading="lazy" />
          <figcaption>Wires</figcaption>
        </figure>
        <figure>
          <img
            src={withBase("assets/yambox-repositioning.webp")}
            alt="YAMBox repositioning an object"
            loading="lazy"
          />
          <figcaption>Repositioning</figcaption>
        </figure>
      </div>
    </section>

    <section id="benchmarks" class="section container container--wide">
      <p class="section-kicker">Simulation</p>
      <h2>Simulated benchmarks</h2>

      <article class="result-block">
        <div class="result-block__header">
          <div>
            <h3>LIBERO</h3>
            <p>
              Fine-tuned for 40,000 steps with a global batch size of 128, then
              improved with a modified noise policy using
              <a href="https://github.com/microsoft/FlowDAgger">FlowDAgger</a>.
            </p>
          </div>
          <a class="text-link" href="https://huggingface.co/microsoft/rho-libero">
            Download rho-libero ↗
          </a>
        </div>
        <div class="table-wrap">
          <table class="results-table">
            <thead>
              <tr><th>Model</th><th>Spatial</th><th>Object</th><th>Goal</th><th>Long</th><th>Average</th></tr>
            </thead>
            <tbody>
              {liberoRows.map((row) => (
                <tr class:list={{ highlight: row[0] === "Rho" }}>
                  {row.map((value, index) => index === 0 ? <th scope="row">{value}</th> : <td>{value}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          Evaluate the released checkpoint by following the instructions in the
          <a href="https://github.com/microsoft/rhobotics#readme">repository README</a>.
        </p>
      </article>

      <article class="result-block">
        <div class="result-block__header">
          <div>
            <h3>RoboEval</h3>
            <p>Mean success over three evaluation passes. Error bars show sample standard deviation.</p>
          </div>
          <strong class="metric">73.37% overall</strong>
        </div>
        <figure class="figure figure--wide">
          <img src={withBase("assets/fig-roboeval.png")} alt="RoboEval success rate by task and model" loading="lazy" />
        </figure>
        <details>
          <summary>Additional checkpoint comparison</summary>
          <figure class="figure">
            <img
              src={withBase("assets/roboeval_comparison_k.png")}
              alt="RoboEval comparison across 10k, 20k, 30k, and 40k checkpoints"
              loading="lazy"
            />
            <figcaption>
              Supplemental checkpoint comparison. The experiment definition for
              <code>k</code> and its relationship to the primary protocol are still
              being documented.
            </figcaption>
          </figure>
        </details>
      </article>

      <article class="result-block">
        <div class="result-block__header">
          <div>
            <h3>RoboTwin</h3>
            <p>
              Controlled transfer from the pretrained and embodiment-mid-trained
              checkpoints across downstream-data budgets.
            </p>
          </div>
          <a class="text-link" href="https://robotwin-platform.github.io/leaderboard">
            RoboTwin leaderboard ↗
          </a>
        </div>
        <figure class="figure figure--wide">
          <img
            src={withBase("assets/fig-robotwin-midtraining.png")}
            alt="RoboTwin easy and hard results across fine-tuning data budgets"
            loading="lazy"
          />
          <figcaption>
            Mid-training provides the largest gains in low-data adaptation and
            improves the 100% data result on the Hard protocol.
          </figcaption>
        </figure>
        <div class="callout">
          <strong>Five-task result:</strong> Rho 100% Midtrain reaches 65.6% on
          Easy and 59.6% on Hard, compared with π0.5 at 59.6% and 35.2%.
        </div>
        <details>
          <summary>Five-task leaderboard comparison</summary>
          <p class="note">
            The comparison uses Hanging Mug, Move Stapler Pad, Place Burger Fries,
            Handover Mic, and Stack Bowls Three. Leaderboard policies use different
            training settings, so this compares evaluation performance rather than
            controlled training recipes.
          </p>
          <div class="table-wrap">
            <table class="results-table">
              <thead>
                <tr><th>Policy</th><th>Training setting</th><th>Easy</th><th>Hard</th><th>Average</th></tr>
              </thead>
              <tbody>
                {robotwinSummary.map((row) => (
                  <tr class:list={{ highlight: row[0] === "Rho 100% Midtrain" }}>
                    {row.map((value, index) => index < 2 ? <th scope={index === 0 ? "row" : undefined}>{value}</th> : <td>{value}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </article>
    </section>

    <section id="efficiency" class="section section--tint">
      <div class="container container--wide">
        <p class="section-kicker">Systems</p>
        <h2>Training efficiency</h2>
        <p class="section-intro">
          Rho offers low-memory full and expert-only training profiles. Lower values
          are better for peak VRAM and seconds per step.
        </p>
        <div class="table-wrap">
          <table class="results-table">
            <thead>
              <tr><th>Framework</th><th>Recipe</th><th>Trainable</th><th>GC</th><th>Peak VRAM ↓</th><th>Time/step ↓</th></tr>
            </thead>
            <tbody>
              {efficiencyRows.map((row) => (
                <tr class:list={{ highlight: row[0] === "Rho" }}>
                  {row.map((value, index) => index < 2 ? <th scope={index === 0 ? "row" : undefined}>{value}</th> : <td>{value}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          These are observed training profiles rather than a model-quality
          benchmark. Precision, gradient checkpointing, trainable scope, and NFS
          differ across recipes. MolmoAct2 measurements use a batch size of 16;
          its expert-only runs set
          <code>--policy.train_action_expert_only=true</code>.
        </p>
      </div>
    </section>

    <section id="models" class="section container">
      <p class="section-kicker">Open weights</p>
      <h2>Models and resources</h2>
      <div class="release-grid">
        <a href="https://huggingface.co/microsoft/rho-base"><strong>rho-base</strong><span>Base pretrained model</span></a>
        <a href="https://huggingface.co/microsoft/rho-libero"><strong>rho-libero</strong><span>LIBERO fine-tuned model</span></a>
        <a href="https://huggingface.co/microsoft/rho-fr3-duo"><strong>rho-fr3-duo</strong><span>FR3 Duo mid-trained model</span></a>
        <a href="https://huggingface.co/microsoft/rho-ur-ai-trainer"><strong>rho-ur-ai-trainer</strong><span>UR5e mid-trained model</span></a>
        <a href="https://huggingface.co/microsoft/rho-yam-box"><strong>rho-yam-box</strong><span>YAMBox mid-trained model</span></a>
        <a href="https://github.com/microsoft/rhobotics"><strong>rhobotics</strong><span>Training and evaluation code</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 72px 0 56px;
    background:
      radial-gradient(circle at 15% 20%, rgba(0, 103, 184, 0.12), transparent 32%),
      radial-gradient(circle at 85% 20%, rgba(209, 73, 91, 0.1), transparent 30%);
    text-align: center;
  }
  .eyebrow,
  .section-kicker {
    margin: 0 0 10px;
    color: var(--link);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero h1 {
    font-size: clamp(4rem, 12vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }
  .hero__dek {
    max-width: 780px;
    margin: 28px auto 0;
    color: var(--text-muted);
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    line-height: 1.5;
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }
  .button {
