  .diagnostic-card__sub { color: var(--text-muted); font-size: 0.82rem; }
  @media (max-width: 900px) {
    .hero__media--sizzle { grid-template-columns: 1fr; }
    .hero__variants { max-width: 768px; }
  }
  @media (max-width: 720px) {
    .diagnostic-grid { grid-template-columns: 1fr; }
  }
  .embodiment-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 40px 0;
  }
  .embodiment-card {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
  }
  .embodiment-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .embodiment-card div { padding: 18px; }
  .embodiment-card h3 { margin-top: 0; }
  .embodiment-card p { color: #d4e0e8; font-size: var(--type-body); }
  .embodiment-card a { color: #78c7ff; font-weight: 600; }
  .table-wrap--dark {
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
  }
  .table-wrap--dark thead th { background: rgba(255, 255, 255, 0.1); color: #fff; }
  .table-wrap--dark th,
  .table-wrap--dark td { border-color: rgba(255, 255, 255, 0.14); }
  .note--dark { color: #bdcbd5; }
  .hardware-result {
    display: grid;
    grid-template-columns: minmax(260px, 0.65fr) 1.35fr;
    align-items: center;
    gap: 50px;
    padding: 42px 0;
    border-bottom: 1px solid var(--rule);
  }
  .hardware-result--reverse > div { order: 2; }
  .hardware-result--reverse > figure { order: 1; }
  .hardware-result--reverse {
    grid-template-columns: 1.35fr minmax(260px, 0.65fr);
  }
  .hardware-result__media {
    grid-column: 1 / -1;
    order: 3 !important;
  }
  .hardware-result__chart {
    margin: 0;
  }
  .hardware-result h2 { font-size: var(--type-section-heading); }
  .clip-grid,
  .task-clips {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 48px;
  }
  .task-clips {
    margin-top: 0;
  }
  .task-clips--fr3 {
    grid-template-columns: repeat(2, 1fr);
  }
  .task-clips--ur5e {
    grid-template-columns: repeat(2, 1fr);
  }
  .clip-grid figure,
  .task-clips figure { margin: 0; }
  .clip-grid img,
  .task-clips img,
  .clip-grid video,
  .task-clips video {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
  }
  .clip-grid figcaption,
  .task-clips figcaption {
    margin-top: 6px;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .release-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-top: 32px;
  }
  .release-grid a {
    display: flex;
    flex-direction: column;
    padding: 20px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    color: var(--text);
