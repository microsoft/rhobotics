        </figure>
        <figure>
          <img
            src={withBase("assets/yambox-sizzle.webp")}
            alt="YAM Box highlight reel"
            loading="lazy"
          />
          <figcaption>YAM Box · bimanual panel and control-board tasks</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <nav class="section-nav" aria-label="Page sections">
    <div class="container container--wide">
      <a href="#overview">Overview</a>
      <a href="#adaptation">Training recipe</a>
      <a href="#method">Method</a>
      <a href="#embodiments">Embodiments</a>
      <a href="#benchmarks">Benchmarks</a>
