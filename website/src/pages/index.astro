<script>
  // Tables that sit side by side in a `[data-sync-tables]` grid keep their
  // header rows at equal heights, so if one table's column headers wrap onto
  // two lines, the other's header row grows to match. (The subheads above the
  // tables are aligned by CSS subgrid; table rows can't be, hence the script.)
  // No-op when the grid has collapsed to a single column.
  const syncHeights = (grid: HTMLElement) => {
    const rows = Array.from(grid.querySelectorAll<HTMLTableRowElement>("thead tr"));
    if (rows.length < 2) return;
    rows.forEach((row) => (row.style.height = ""));
    const sideBySide = getComputedStyle(grid).gridTemplateColumns.trim().split(/\s+/).length > 1;
    if (!sideBySide) return;
    const tallest = Math.max(...rows.map((row) => row.getBoundingClientRect().height));
    rows.forEach((row) => (row.style.height = `${tallest}px`)); // height acts as a minimum on table rows
  };

  document.querySelectorAll<HTMLElement>("[data-sync-tables]").forEach((grid) => {
    let lastWidth = -1;
    const update = () => {
      const width = grid.getBoundingClientRect().width;
      if (width === lastWidth) return; // our own height changes re-trigger the observer
      lastWidth = width;
      syncHeights(grid);
    };
    new ResizeObserver(update).observe(grid);
    update();
    document.fonts?.ready.then(() => { lastWidth = -1; update(); });
  });
</script>
